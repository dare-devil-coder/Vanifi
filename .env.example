# Sarvam AI API Key (Required for Indic Speech-to-Text & Vernacular Audio Generation)
# Obtain your key at: https://www.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# Pinecone API Key (Required for Pinecone Vector DB RAG for Financial Literacy & RBI Policies)
# Obtain your key at: https://www.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
